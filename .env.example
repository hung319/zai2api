# ==============================================
# Cấu hình kết nối Upstream (Z.ai)
# ==============================================

# Giao thức kết nối tới Z.ai (mặc định: https)
PROTOCOL=https

# Tên miền API của Z.ai (mặc định: chat.z.ai)
BASE=chat.z.ai

# Token truy cập của tài khoản Z.ai (User Token)
# Bắt buộc nếu ANONYMOUS_MODE=false
TOKEN=

# ==============================================
# Cấu hình Server Proxy
# ==============================================

# Cổng chạy dịch vụ (mặc định: 8080)
PORT=8080

# API Key để bảo vệ Server Proxy này (client phải gửi header Authorization: Bearer <KEY>)
# Để trống để tắt xác thực (ai cũng dùng được).
API_KEY=

# Chế độ ẩn danh / Khách (mặc định: true)
# - true: Sử dụng token ngẫu nhiên (không cần điền TOKEN ở trên), không hỗ trợ upload ảnh.
# - false: Sử dụng TOKEN của bạn, hỗ trợ upload ảnh.
ANONYMOUS_MODE=true

# Proxy server để server này kết nối ra ngoài (nếu mạng chặn Z.ai)
# Ví dụ: http://127.0.0.1:7890
PROXY_URL=

# ==============================================
# Cấu hình Model & Xử lý
# ==============================================

# Model mặc định nếu client không gửi tên model (mặc định: glm-4.6)
MODEL=glm-4.6

# Chế độ xử lý thẻ suy nghĩ (Think Tags) từ Z.ai
# - reasoning: Tách riêng content và reasoning_content (chuẩn OpenAI mới).
# - think: Giữ nguyên thẻ <think>...</think> trong content.
# - strip: Loại bỏ hoàn toàn nội dung suy nghĩ.
# - details: Đóng gói vào thẻ HTML <details> để ẩn/hiện.
THINK_TAGS_MODE=reasoning

# ==============================================
# Debug & Logs
# ==============================================

# Chế độ Debug của Flask (mặc định: false)
# Lưu ý: Không bật trên production
DEBUG=false

# Hiển thị chi tiết log debug trong console (mặc định: false)
DEBUG_MSG=false
